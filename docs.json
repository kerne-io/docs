{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kerne",
  "description": "The authorization layer for monetized software.",
  "favicon": {
    "light": "/images/favicon-32x32.png",
    "dark": "/images/favicon-32x32.png"
  },
  "logo": {
    "light": "/logo/logo-dark.png",
    "dark": "/logo/logo.png",
    "href": "https://docs.kerne.io"
  },
  "appearance": {
    "default": "system"
  },
  "colors": {
    "primary": "#131313",
    "light": "#F7F7F8",
    "dark": "#131313"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111113"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "icon": "discord",
        "href": "https://discord.gg/RDpmPCYZD"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.kerne.io"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": [
              "index",
              "quickstart",
              "concepts/overview"
            ]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/monetization/products-and-plans",
              "concepts/monetization/entitlements",
              "concepts/monetization/usage-billing",
              "concepts/monetization/overrides"
            ]
          },
          {
            "group": "Users & sign-in",
            "pages": [
              "concepts/identity/index",
              "concepts/identity/registration-modes"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "concepts/error-codes",
              "concepts/identity/admin-access",
              "concepts/limits"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "compass",
        "groups": [
          {
            "group": "Quick starts",
            "pages": [
              "guides/first-access-decision",
              "guides/getting-started/subscription-setup",
              "guides/getting-started/authentication-setup"
            ]
          },
          {
            "group": "Common tasks",
            "pages": [
              "guides/billing/designing-pricing",
              "guides/billing/change-your-pricing",
              "guides/billing/enforcing-limits-without-breaking-ux",
              "guides/billing/usage-end-to-end",
              "guides/billing/customer-exceptions",
              "guides/auth/implement-invite-only-saas"
            ]
          }
        ]
      },
      {
        "tab": "SDKs",
        "icon": "cube",
        "groups": [
          {
            "group": "Server SDK",
            "pages": [
              "sdks/server/overview",
              {
                "group": "Authentication",
                "pages": [
                  "sdks/server/auth/signup",
                  "sdks/server/auth/login",
                  "sdks/server/auth/refresh-token",
                  "sdks/server/auth/verify-email",
                  "sdks/server/auth/password-reset",
                  "sdks/server/auth/config",
                  "sdks/server/auth/handoff"
                ]
              },
              {
                "group": "Users",
                "pages": [
                  "sdks/server/users/me",
                  "sdks/server/users/get",
                  "sdks/server/users/update"
                ]
              },
              {
                "group": "Entitlements & usage",
                "pages": [
                  "sdks/server/entitlements/allows-enforce-check",
                  "sdks/server/entitlements/consume",
                  "sdks/server/entitlements/report-usage",
                  "sdks/server/entitlements/list"
                ]
              },
              {
                "group": "Billing",
                "pages": [
                  "sdks/server/billing/subscription",
                  "sdks/server/billing/plans",
                  "sdks/server/billing/checkout",
                  "sdks/server/billing/portal-and-cancel"
                ]
              },
              {
                "group": "Admin",
                "pages": [
                  "sdks/server/admin/usage-corrections",
                  "sdks/server/admin/overrides"
                ]
              },
              {
                "group": "Waitlist",
                "pages": [
                  "sdks/server/waitlist/join",
                  "sdks/server/waitlist/list",
                  "sdks/server/waitlist/remove"
                ]
              },
              {
                "group": "Invitations",
                "pages": [
                  "sdks/server/invitations/create",
                  "sdks/server/invitations/list",
                  "sdks/server/invitations/validate",
                  "sdks/server/invitations/revoke"
                ]
              },
              "sdks/server/request"
            ]
          },
          {
            "group": "Frontend SDKs",
            "pages": [
              "sdks/client/overview",
              {
                "group": "React",
                "pages": [
                  "sdks/client/react/overview",
                  {
                    "group": "Authentication",
                    "pages": [
                      "sdks/client/react/auth/login",
                      "sdks/client/react/auth/register",
                      "sdks/client/react/auth/session",
                      "sdks/client/react/auth/email-verification",
                      "sdks/client/react/auth/password-reset",
                      "sdks/client/react/auth/handoff"
                    ]
                  },
                  {
                    "group": "Billing",
                    "pages": [
                      "sdks/client/react/billing/plans",
                      "sdks/client/react/billing/check-entitlement",
                      "sdks/client/react/billing/entitlements-list",
                      "sdks/client/react/billing/usage",
                      "sdks/client/react/billing/checkout-and-portal"
                    ]
                  },
                  {
                    "group": "Waitlist & invitations",
                    "pages": [
                      "sdks/client/react/waitlist",
                      "sdks/client/react/invitations"
                    ]
                  },
                  {
                    "group": "Prebuilt UI",
                    "pages": [
                      "sdks/client/react/ui/overview",
                      "sdks/client/react/ui/account",
                      "sdks/client/react/ui/pricing-table",
                      "sdks/client/react/ui/theming"
                    ]
                  },
                  "sdks/client/react/components"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "openapi": "openapi.json"
      }
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/RDpmPCYZD",
      "website": "https://kerne.io"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "claude",
      "chatgpt"
    ]
  },
  "seo": {
    "metatags": {
      "og:site_name": "Kerne",
      "og:type": "website",
      "twitter:card": "summary_large_image"
    }
  },
  "redirects": [
    {
      "source": "/guides/is-kerne-a-fit",
      "destination": "/concepts/limits"
    }
  ],
  "thumbnails": {
    "background": "/images/bg.png",
    "fonts": {
      "family": "Geist"
    }
  },
  "interaction": {
    "drilldown": true
  }
}
