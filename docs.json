{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Kerne",
  "description": "The authorization layer for monetized software.",
  "favicon": {
    "light": "/images/favicon-32x32.png",
    "dark": "/images/favicon-32x32.png"
  },
  "logo": {
    "light": "/logo/logo-dark.png",
    "dark": "/logo/logo.png",
    "href": "https://docs.kerne.io"
  },
  "appearance": {
    "default": "system"
  },
  "colors": {
    "primary": "#131313",
    "light": "#F7F7F8",
    "dark": "#131313"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#111113"
    }
  },
  "fonts": {
    "heading": {
      "family": "Geist",
      "weight": 600
    },
    "body": {
      "family": "Geist"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "navbar": {
    "links": [
      {
        "label": "Community",
        "icon": "discord",
        "href": "https://discord.gg/RDpmPCYZD"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.kerne.io"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Get started",
            "pages": ["index", "quickstart", "concepts/overview"]
          },
          {
            "group": "Core concepts",
            "pages": [
              "concepts/monetization/products-and-plans",
              "concepts/monetization/entitlements",
              "concepts/monetization/usage-billing",
              "concepts/monetization/overrides"
            ]
          },
          {
            "group": "Users & sign-in",
            "pages": ["concepts/identity/index", "concepts/identity/registration-modes"]
          },
          {
            "group": "Reference",
            "pages": ["concepts/identity/admin-access", "concepts/limits"]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "compass",
        "groups": [
          {
            "group": "Quick starts",
            "pages": [
              "guides/first-access-decision",
              "guides/getting-started/subscription-setup",
              "guides/getting-started/authentication-setup"
            ]
          },
          {
            "group": "Common tasks",
            "pages": [
              "guides/billing/designing-pricing",
              "guides/billing/change-your-pricing",
              "guides/billing/enforcing-limits-without-breaking-ux",
              "guides/billing/usage-end-to-end",
              "guides/billing/customer-exceptions",
              "guides/auth/implement-invite-only-saas"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "icon": "square-terminal",
        "groups": [
          {
            "group": "Server SDK",
            "pages": [
              "sdks/server/overview",
              "sdks/server/entitlements",
              "sdks/server/usage",
              "sdks/server/billing",
              "sdks/server/authentication",
              "sdks/server/users",
              "sdks/server/admin",
              "sdks/server/waitlist-invitations"
            ]
          },
          {
            "group": "React SDK",
            "pages": [
              "sdks/client/react/overview",
              "sdks/client/react/authentication",
              "sdks/client/react/entitlements",
              "sdks/client/react/billing",
              "sdks/client/react/waitlist-invitations",
              {
                "group": "Prebuilt UI",
                "pages": [
                  "sdks/client/react/ui/overview",
                  "sdks/client/react/ui/account",
                  "sdks/client/react/ui/pricing-table",
                  "sdks/client/react/ui/theming"
                ]
              }
            ]
          },
          {
            "group": "REST API",
            "pages": ["api-reference/introduction", "concepts/error-codes"]
          },
          {
            "group": "Endpoints",
            "openapi": "openapi.json"
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "discord": "https://discord.gg/RDpmPCYZD",
      "website": "https://kerne.io"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt"]
  },
  "seo": {
    "metatags": {
      "og:site_name": "Kerne",
      "og:type": "website",
      "twitter:card": "summary_large_image"
    }
  },
